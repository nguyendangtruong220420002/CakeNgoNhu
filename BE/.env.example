# Copy file này thành .env.local và điền giá trị thật. KHÔNG commit .env.local lên Git.

# Connection string MongoDB (Atlas hoặc local)
MONGODB_URI=

# Port chạy server Express
PORT=5000

# Secret dùng để ký JWT cho admin (chuỗi ngẫu nhiên, đủ dài)
JWT_SECRET=

# Domain của web khách hàng, dùng để cấu hình CORS
# Có thể để nhiều domain, cách nhau bằng dấu phẩy (VD: dev + production)
CLIENT_URL=http://localhost:3000,https://cake-ngo-nhu.vercel.app
