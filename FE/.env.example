# Copy file này thành .env.local và điền giá trị thật. KHÔNG commit .env.local lên Git.

# URL của BE Express API
NEXT_PUBLIC_API_URL=http://localhost:5000

# Cloudinary — dùng để upload ảnh mẫu bánh trực tiếp từ trang admin
# Cloud name không phải bí mật (xem ở Cloudinary Dashboard), nhưng upload preset PHẢI đặt Unsigned
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
